# Copia este archivo como .env y coloca tu clave real de Groq.
# Obtenla en https://console.groq.com/keys
GROQ_API_KEY=tu_clave_de_groq_aqui

# Modelo principal y de respaldo (opcional, estos son los valores por defecto).
# Nota: usa modelos a los que tu cuenta de Groq tenga acceso. Los GPT-OSS estan
# disponibles en el tier gratuito y soportan tool calling.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_FALLBACK=openai/gpt-oss-120b

# API key de OpenAQ (opcional). Solo se necesita para RE-DESCARGAR los datos
# reales con scripts/descargar_datos_openaq.py. Obtenla gratis en
# https://explore.openaq.org/register
OPENAQ_API_KEY=tu_clave_de_openaq_aqui
